+    for (int i = 0; i < OFFLOAD_FLOW_BUCKETS; ++i) {
+        const struct hmap* map= &table->hash_table_array[i].key_hmap;
+        if (hinic3_hmap_is_empty(map)) {
+            continue;
+        }
+        if (hinic3_dump_rte_flows_of_bucket(m, map, flow_count) != 0)
+            return -1;
+    }
+    return 0;
+}
