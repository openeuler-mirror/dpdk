+static int
+hinic3_process_fullkey_5tuple(const struct hinic3_conntrack_key *conntrack_key, struct hwoff_nlattr *values)
+{
+    struct hinic3_key_5tuple *tuple = (struct hinic3_key_5tuple *)conntrack_key->key;
+    struct hinic3_key_vxlan_vid_5tuple *port_key = (struct hinic3_key_vxlan_vid_5tuple *)conntrack_key->key;
+    struct hinic3_key_raw_ip *raw_ip = (struct hinic3_key_raw_ip *)conntrack_key->key;
+    hinic3_nlattr_put_u16(values, HINIC3_FLOW_KEY_IN_PORT, port_key->input_port);
+    hinic3_nlattr_put_u16(values, HINIC3_FLOW_KEY_DL_TYPE, tuple->ip.ether_type);
+    hinic3_nlattr_put_unspec(values, HINIC3_FLOW_KEY_SRC_MAC, tuple->eth.smac, sizeof(tuple->eth.smac));
+    hinic3_nlattr_put_unspec(values, HINIC3_FLOW_KEY_DST_MAC, tuple->eth.dmac, sizeof(tuple->eth.dmac));
+    hinic3_nlattr_put_u32(values, HINIC3_FLOW_KEY_SRC_IP, tuple->ip.src.ipv4);
+    hinic3_nlattr_put_u32(values, HINIC3_FLOW_KEY_DST_IP, tuple->ip.dst.ipv4);
+    if (conntrack_key->meta.tcp_udp_flag == HINIC3_CT_DEFAULT_FLAG) {
+        hinic3_nlattr_put_u8(values, HINIC3_FLOW_KEY_PROTOCOL, raw_ip->protocol);
+    } else {
+        hinic3_nlattr_put_u8(values, HINIC3_FLOW_KEY_PROTOCOL, hinic3_ct_get_proto_by_flag(conntrack_key->meta.tcp_udp_flag));
+    }
+    hinic3_nlattr_put_u16(values, HINIC3_FLOW_KEY_SRC_PORT, tuple->port_src);
+    hinic3_nlattr_put_u16(values, HINIC3_FLOW_KEY_DST_PORT, tuple->port_dst);
+    return 0;
+}
+
+static int 
+hinic3_process_fullkey_vid_5tuple(const struct hinic3_conntrack_key *conntrack_key, struct hwoff_nlattr *values)
+{
+    struct hinic3_key_vid_5tuple *tuple = (struct hinic3_key_vid_5tuple *)conntrack_key->key;
+    hinic3_process_fullkey_5tuple(conntrack_key, values);
+    hinic3_nlattr_put_u16(values, HINIC3_FLOW_KEY_OUTER_VID, tuple->outer_vid);
+    return 0;
+}
+
+static int 
+hinic3_process_fullkey_vxlan_vid_5tuple(const struct hinic3_conntrack_key *conntrack_key, struct hwoff_nlattr *values)
+{
+    struct hinic3_key_vxlan_vid_5tuple *tuple = (struct hinic3_key_vxlan_vid_5tuple *)conntrack_key->key;
+    hinic3_process_fullkey_5tuple(conntrack_key, values);
+    hinic3_process_fullkey_vid_5tuple(conntrack_key, values);
+    hinic3_nlattr_put_u32(values, HINIC3_FLOW_KEY_VNI, tuple->vxlan.vni);
+    return 0;
+}
+
+static struct hinic3_format_fullkey_callback_info callback_infos[] = {
+    [HINIC3_KEY_5TUPLE] = {hinic3_process_fullkey_5tuple, "process fullkey 5tuple"},
+    [HINIC3_KEY_VID_5TUPLE] = {hinic3_process_fullkey_vid_5tuple, "process fullkey vid 5tuple"},
+    [HINIC3_KEY_VXLAN_5TUPLE] = {hinic3_process_fullkey_vxlan_vid_5tuple, "process fullkey vxlan 5tuple"},
+    [HINIC3_KEY_VXLAN_VID_5TUPLE] = {hinic3_process_fullkey_vxlan_vid_5tuple, "process fullkey vxlan vid 5tuple"},
+    [HINIC3_KEY_VID_VXLAN_5TUPLE] = {hinic3_process_fullkey_vxlan_vid_5tuple, "process fullkey vid vxlan 5tuple"},
+    [HINIC3_KEY_VID_VXLAN_VID_5TUPLE] = {hinic3_process_fullkey_vxlan_vid_5tuple, "process fullkey vid vxlan vid 5tuple"}
+};
+
+int
+hinic3_format_conntrack_fullkey(const struct hinic3_conntrack_full_key *fullkey, struct ds *ds)
+{
+    int type;
+    int ret;
+    if (type >= HINIC3_KEY_END)
+        return -1;
+    type = fullkey->key.meta.type;
+    struct hinic3_format_fullkey_callback_info info = callback_infos[type];
+    struct hinic3_nlattr key;
+    uint8_t key_buf[HINIC3_MSG_MAX_BUF];
+    hinic3_nlattr_init(&key, key_buf, HINIC3_MSG_MAX_BUF);
+    hinic3_ds_put_format(ds, "%s%d, ", HINIC3_UI_FLOW_CONNTRACK_KEY_TUPLE_TYPE_STRING, type);
+    hinic3_ds_put_format(ds, "%s", HINIC3_UI_FLOW_KEY_STRING);
+    if (info.callback == NULL)
+        return -1;
+    
+    ret = info.callback(&fullkey->key, &key);
+    if (ret != 0 ) {
+        HINIC3_LOG(ERR, FLOW, "hinic3 format fullkey in %s, ret:%d", info.str, ret);
+        return -1;
+    }
+    hinic3_flow_key_format_output(&key, ds);
+    hinic3_ds_put_format(ds, " END\n");
+    return 0;
+}
+
+static inline void
+hinic3_format_rte_flow_ufid(uint64_t ufid, struct ds *ds)
+{
+    hinic3_ds_put_format(ds, "%s", HINIC3_UI_FLOW_UFID_STRING);
+    hinic3_ds_put_format(ds, HINIC3_HW_UFID_FMT, HINIC3_HW_UFID_ARGS(ufid));
+    hinic3_ds_put_format(ds, ", ");
+}
+
+static inline void
+hinic3_format_offload_status(uint32_t offload, struct ds *ds)
+{
+    hinic3_ds_put_format(ds, "%s: %u,", HINIC3_UI_FLOW_OFFLOAD_STRING, offload);
+}
+
+int
+hinic3_format_rte_flow(const struct rte_flow *flow, struct ds *ds)
+{
+    const struct hinic3_conntrack_full_key *key = &flow->key;
+    hinic3_format_rte_flow_ufid(flow->hw_ufid, ds);
+    hinic3_format_offload_status(flow->flags.is_offload, ds);
+    return hinic3_format_conntrack_fullkey(key, ds);
+}
+
+static const void* hinic3_get_mega_flow_item(const struct hinic3_mega_key *key, enum rte_flow_item_type type)
+{
+    switch (type) {
+        case RTE_FLOW_ITEM_TYPE_PORT_ID:
+            return (const void*)&key->in_port;
+        case RTE_FLOW_ITEM_TYPE_ETH:
+            return (const void*)&key->eth;
+        case RTE_FLOW_ITEM_TYPE_VXLAN:
+            return (const void*)&key->vxlan;
+        default:
+            return NULL;
+    }
+    return NULL;
+}
+
+static inline void
+hinic3_format_rte_flow_mage_index(uint32_t index, struct ds *ds)
+{
+    hinic3_ds_put_format(ds, "%s:%u", HINIC3_UI_FLOW_MEGA_INDEX_STRING, index);
+}
+
+int
+hinic3_format_rte_flow_mega(const struct hinic3_mega_flow *flow, struct ds *ds)
+{
+    struct hinic3_flow format;
+    hinic3_format_rte_flow_ufid(flow->ufid, ds);
+    hinic3_format_rte_flow_mage_index(flow->index, ds);
+    const struct hinic3_mega_flow_full_key* key = &flow->full_key;
+    size_t i = 0;
+    for (; i < key->item_num; ++i) {
+        enum rte_flow_item_type type = key->item_types[i];
+        format.items[i].type = type;
+        format.items[i].spec = hinic3_get_mega_flow_item(&key->mega_key, type);
+        format.items[i].mask = hinic3_get_mega_flow_item(&key->mask, type);
+    }
+    format.items[i].type = RTE_FLOW_ITEM_TYPE_END;
+    format.items[i].spec = NULL;
+    format.items[i].mask = NULL;
+    return hinic3_format_mega_flow_items(&format, ds);
+}
+
+bool
+hinic3_get_dump_rte_flow_options(int argc, const char *argv[])
+{
+    for (int i = argc; i > 0; --i) {
+        if (strcmp("-r", argv[i - 1]) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
