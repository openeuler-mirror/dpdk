+                     -ERANGE 解析结果超过[1, HWOFF_MAX_DURATION]
+ */
+time_t hinic3_parse_string_to_duration(const char *time_str);
+ 
+/*
+ * 函 数 名 : hinic3_transform_duration_to_string
+ * 功能描述 : 时间戳转换为时间字符
+ * 输入参数 : @param time_sec  复位时间秒数
+ * 返 回 值 : @return 返回时间字符串时分秒结构(1h5m30s)
