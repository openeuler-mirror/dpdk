+static void hinic3_multi_flow_qos_show_sub(struct ds *ds, bool is_all, bool is_used)
+{
+    if (is_all == true)
+    {
+        hinic3_multi_flow_qos_show_all(ds);
+    }
+    else
+    {
+        hinic3_multi_flow_qos_show_part(ds, is_used);
+    }
+}
