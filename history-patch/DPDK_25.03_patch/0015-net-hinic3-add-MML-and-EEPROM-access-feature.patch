+	if (show_q->qobj > OBJ_WQE_INFO || show_q->qobj < OBJ_Q_INFO) {
+		self->err_no = -UDA_EINVAL;
+		snprintf(self->err_str, COMMANDER_ERR_MAX_STRING - 1,
+			     "Unknown queue type.");
+		return self->err_no;
+	}
+
+	if (show_q->q_id == -1) {
+		self->err_no = -UDA_EINVAL;
+		snprintf(self->err_str, COMMANDER_ERR_MAX_STRING - 1,
+			     "Need queue id.");
