+int
+hinic3_add_tcam_rule(void *hwdev, struct hinic3_tcam_cfg_rule *tcam_rule,
+		     u8 tcam_rule_type)
+{
+	struct hinic3_fdir_add_rule tcam_cmd;
+	u16 out_size = sizeof(tcam_cmd);
+	int err;
+
+	if (!hwdev || !tcam_rule)
+		return -EINVAL;
