From 24b3b8b415bf824699ca12a660f94ae2ae7c3a50 Mon Sep 17 00:00:00 2001
From: xiaobai <chenyi19990512@163.com>
Date: Tue, 6 May 2025 11:40:29 +0800
Subject: [PATCH 8/9] modify phyport stats strings

---
 drivers/net/hinic3/base/hinic3_pmd_nic_cfg.h | 2 +-
 drivers/net/hinic3/hinic3_pmd_ethdev.c       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/hinic3/base/hinic3_pmd_nic_cfg.h b/drivers/net/hinic3/base/hinic3_pmd_nic_cfg.h
index 1ddce37..5dcb25a 100644
--- a/drivers/net/hinic3/base/hinic3_pmd_nic_cfg.h
+++ b/drivers/net/hinic3/base/hinic3_pmd_nic_cfg.h
@@ -524,7 +524,7 @@ struct mag_phy_port_stats {
 	u64 mac_rx_pfc_pri7_pkt_num;
 	u64 mac_rx_control_pkt_num;
 	u64 mac_rx_sym_err_pkt_num;
-	u64 mac_rx_fcs_err_pkt_num;
+	u64 rx_crc_errors;
 	u64 mac_rx_send_app_good_pkt_num;
 	u64 mac_rx_send_app_bad_pkt_num;
 	u64 mac_rx_unfilter_pkt_num;
diff --git a/drivers/net/hinic3/hinic3_pmd_ethdev.c b/drivers/net/hinic3/hinic3_pmd_ethdev.c
index 3e8f8bc..e128c0b 100644
--- a/drivers/net/hinic3/hinic3_pmd_ethdev.c
+++ b/drivers/net/hinic3/hinic3_pmd_ethdev.c
@@ -192,7 +192,7 @@ static const struct hinic3_xstats_name_off hinic3_phyport_stats_strings[] = {
 	HINIC3_PORT_STAT(mac_rx_pfc_pri7_pkt_num),
 	HINIC3_PORT_STAT(mac_rx_control_pkt_num),
 	HINIC3_PORT_STAT(mac_rx_sym_err_pkt_num),
-	HINIC3_PORT_STAT(mac_rx_fcs_err_pkt_num),
+	HINIC3_PORT_STAT(rx_crc_errors),
 	HINIC3_PORT_STAT(mac_rx_send_app_good_pkt_num),
 	HINIC3_PORT_STAT(mac_rx_send_app_bad_pkt_num),
 	HINIC3_PORT_STAT(mac_rx_unfilter_pkt_num)
