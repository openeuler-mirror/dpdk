From f81c1dd2c1c9c653c24f2b4769ed073d6e43a2ca Mon Sep 17 00:00:00 2001
From: Huawei <@huawei.com>
Date: Thu, 8 May 2025 10:27:01 +0800
Subject: [PATCH 04/20] Support checksum offload calculation in DPDK VXLAN
 scenario

Signed-off-by: Huawei <@huawei.com>
---
 drivers/net/hinic3/hinic3_pmd_ethdev.c |  1 +
 drivers/net/hinic3/hinic3_pmd_ethdev.h |  1 +
 drivers/net/hinic3/hinic3_pmd_tx.c     | 92 ++++++++++++++++++++++++++
 drivers/net/hinic3/hinic3_pmd_tx.h     |  9 +++
 4 files changed, 103 insertions(+)

diff --git a/drivers/net/hinic3/hinic3_pmd_ethdev.c b/drivers/net/hinic3/hinic3_pmd_ethdev.c
index 8f8a870..fdf57ab 100644
--- a/drivers/net/hinic3/hinic3_pmd_ethdev.c
+++ b/drivers/net/hinic3/hinic3_pmd_ethdev.c
@@ -390,6 +390,7 @@ static void hinic3_dev_info_get(struct rte_eth_dev_info *info, struct hinic3_nic
 				RTE_ETH_TX_OFFLOAD_TCP_CKSUM |
 				RTE_ETH_TX_OFFLOAD_SCTP_CKSUM |
 				RTE_ETH_TX_OFFLOAD_OUTER_IPV4_CKSUM |
+				RTE_ETH_TX_OFFLOAD_OUTER_UDP_CKSUM |
 				RTE_ETH_TX_OFFLOAD_TCP_TSO |
 				RTE_ETH_TX_OFFLOAD_MULTI_SEGS;
 
diff --git a/drivers/net/hinic3/hinic3_pmd_ethdev.h b/drivers/net/hinic3/hinic3_pmd_ethdev.h
index 27e8fb9..7fa3d72 100644
--- a/drivers/net/hinic3/hinic3_pmd_ethdev.h
+++ b/drivers/net/hinic3/hinic3_pmd_ethdev.h
@@ -38,6 +38,7 @@
 #define HINIC3_PKT_TX_TUNNEL_MASK        RTE_MBUF_F_TX_TUNNEL_MASK
 #define HINIC3_PKT_TX_TUNNEL_VXLAN       RTE_MBUF_F_TX_TUNNEL_VXLAN
 #define HINIC3_PKT_TX_OUTER_IP_CKSUM     RTE_MBUF_F_TX_OUTER_IP_CKSUM
+#define HINIC3_PKT_TX_OUTER_UDP_CKSUM    RTE_MBUF_F_TX_OUTER_UDP_CKSUM
 #define HINIC3_PKT_TX_OUTER_IPV6         RTE_MBUF_F_TX_OUTER_IPV6
 #define HINIC3_PKT_RX_LRO                RTE_MBUF_F_RX_LRO
 #define HINIC3_PKT_TX_L4_NO_CKSUM        RTE_MBUF_F_TX_L4_NO_CKSUM
diff --git a/drivers/net/hinic3/hinic3_pmd_tx.c b/drivers/net/hinic3/hinic3_pmd_tx.c
index c3113f4..e73ed3e 100644
--- a/drivers/net/hinic3/hinic3_pmd_tx.c
+++ b/drivers/net/hinic3/hinic3_pmd_tx.c
@@ -5,6 +5,8 @@
 #include <rte_ether.h>
 #include <rte_mbuf.h>
 #include <rte_io.h>
+#include <rte_net.h>
+#include <rte_vxlan.h>
 
 #include "base/hinic3_compat.h"
 #include "base/hinic3_pmd_mgmt.h"
@@ -382,6 +384,86 @@ static inline void hinic3_set_vlan_tx_offload(struct hinic3_sq_task *task,
 			     SQ_TASK_INFO3_SET(1U, VLAN_TAG_VALID);
 }
 
+static inline uint8_t hinic3_get_ipv4_proto(const void *hdr) {
+	return ((const struct rte_ipv4_hdr *)hdr)->next_proto_id;
+}
+
+static inline uint8_t hinic3_get_ipv6_proto(const void *hdr) {
+	return ((const struct rte_ipv6_hdr *)hdr)->proto;
+}
+
+static hinic3_ip_cs_handler_t g_ip_cs_handlers[] = {
+	[IPV4_VERSION] = {
+		.cksum_func = (uint16_t (*)(const void *, uint64_t))rte_ipv4_phdr_cksum,
+		.hdr_size = sizeof(struct rte_ipv4_hdr),
+		.get_proto = hinic3_get_ipv4_proto,
+	},
+	[IPV6_VERSION] = {
+		.cksum_func = (uint16_t (*)(const void *, uint64_t))rte_ipv6_phdr_cksum,
+		.hdr_size = sizeof(struct rte_ipv6_hdr),
+		.get_proto = hinic3_get_ipv6_proto,
+	},
+};
+
+static uint8_t hinic3_ip_phdr_cksum(hinic3_ip_cs_handler_t *ip_handler, uint8_t *pkt_data, struct rte_mbuf *mbuf)
+{
+	struct rte_tcp_hdr *tcp_hdr = NULL;
+	struct rte_udp_hdr *udp_hdr = NULL;
+	uint8_t proto = ip_handler->get_proto(pkt_data);
+
+	if (proto == IPPROTO_TCP) {
+		tcp_hdr = (struct rte_tcp_hdr *)(pkt_data + ip_handler->hdr_size);
+		tcp_hdr->cksum = ip_handler->cksum_func(pkt_data, mbuf->ol_flags);
+	} else if (proto == IPPROTO_UDP) {
+		udp_hdr = (struct rte_udp_hdr *)(pkt_data + ip_handler->hdr_size);
+		udp_hdr->dgram_cksum = ip_handler->cksum_func(pkt_data, mbuf->ol_flags);
+	}
+
+	return proto;
+}
+
+static int hinic3_vxlan_tso_ip_phdr_cksum(struct rte_mbuf *mbuf) {
+	uint8_t *ip_hdr = NULL;
+	uint8_t version, l4_proto;
+	uint16_t offset = 0;
+	hinic3_ip_cs_handler_t *ip_handler = NULL;
+	uint8_t *pkt_data = rte_pktmbuf_mtod(mbuf, uint8_t *);
+	
+	offset += sizeof(struct rte_ether_hdr);
+	ip_hdr = (uint8_t *)(pkt_data + offset);
+	version = (*ip_hdr >> 4) & 0x0F;
+	if (version == IPV4_VERSION || version == IPV6_VERSION) {
+		ip_handler = &g_ip_cs_handlers[version];
+		/* 外层UDP的伪头部checksum计算 */
+		l4_proto = hinic3_ip_phdr_cksum(ip_handler, ip_hdr, mbuf);
+		if (unlikely(l4_proto != IPPROTO_UDP)) {
+			PMD_DRV_LOG(INFO, "not support outer l4 proto(%u) by vxlan checksum", l4_proto);
+			return -EINVAL;
+		}
+	} else {
+		PMD_DRV_LOG(INFO, "not support outer l3 version(%u) by vxlan checksum", version);
+		return -EINVAL;
+	}
+
+	offset += ip_handler->hdr_size + sizeof(struct rte_udp_hdr) + sizeof(struct rte_vxlan_hdr) + sizeof(struct rte_ether_hdr);
+	ip_hdr = (uint8_t *)(pkt_data + offset);
+	version = (*ip_hdr >> 4) & 0x0F;
+	if (version == IPV4_VERSION || version == IPV6_VERSION) {
+		ip_handler = &g_ip_cs_handlers[version];
+		/* 内层TCP/UDP的伪头部checksum计算 */
+		l4_proto = hinic3_ip_phdr_cksum(ip_handler, ip_hdr, mbuf);
+		if (unlikely(l4_proto != IPPROTO_TCP && l4_proto != IPPROTO_UDP)) {
+			PMD_DRV_LOG(INFO, "not support inner l4 proto(%u) by vxlan checksum", l4_proto);
+			return -EINVAL;
+		}
+	} else {
+		PMD_DRV_LOG(INFO, "not support outer l3 version(%u) by vxlan checksum", version);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 static int hinic3_set_tx_offload(struct rte_mbuf *mbuf,
 				 struct hinic3_sq_task *task,
 				 struct hinic3_wqe_info *wqe_info)
@@ -421,6 +503,13 @@ static int hinic3_set_tx_offload(struct rte_mbuf *mbuf,
 		/* Set MSS value */
 		queue_info = SQ_CTRL_QUEUE_INFO_CLEAR(queue_info, MSS);
 		queue_info |= SQ_CTRL_QUEUE_INFO_SET(mbuf->tso_segsz, MSS); /*lint !e40*/
+
+		/* vxlan TSO场景下，内外层L4里的伪头部的checksum不能包含L4的长度，需要置零 */
+		if (ol_flags & HINIC3_PKT_TX_TUNNEL_MASK) {
+			if(unlikely(hinic3_vxlan_tso_ip_phdr_cksum(mbuf))) {
+				return -EINVAL;
+			}
+		}
 	} else {
 		if (ol_flags & HINIC3_PKT_TX_IP_CKSUM)
 			task->pkt_info0 |= SQ_TASK_INFO0_SET(1U, INNER_L3_EN);
@@ -460,6 +549,9 @@ static int hinic3_set_tx_offload(struct rte_mbuf *mbuf,
 	if (ol_flags & HINIC3_PKT_TX_OUTER_IP_CKSUM)
 		task->pkt_info0 |= SQ_TASK_INFO0_SET(1U, OUT_L3_EN);
 
+	if (ol_flags & HINIC3_PKT_TX_OUTER_UDP_CKSUM)
+		task->pkt_info0 |= SQ_TASK_INFO0_SET(1U, OUT_L4_EN);
+
 	task->pkt_info0 = hinic3_hw_be32(task->pkt_info0);
 	task->pkt_info2 = hinic3_hw_be32(task->pkt_info2);
 	wqe_info->queue_info = queue_info;
diff --git a/drivers/net/hinic3/hinic3_pmd_tx.h b/drivers/net/hinic3/hinic3_pmd_tx.h
index bfae4cf..e43dfc3 100644
--- a/drivers/net/hinic3/hinic3_pmd_tx.h
+++ b/drivers/net/hinic3/hinic3_pmd_tx.h
@@ -313,6 +313,15 @@ struct hinic3_txq {
 #endif
 } __rte_cache_aligned;
 
+#define IPV4_VERSION 4
+#define IPV6_VERSION 6
+
+typedef struct {
+	uint16_t (*cksum_func)(const void *hdr, uint64_t ol_flags);
+	size_t hdr_size;
+	uint8_t (*get_proto)(const void *hdr);
+} hinic3_ip_cs_handler_t;
+
 void hinic3_flush_txqs(struct hinic3_nic_dev *nic_dev);
 
 void hinic3_free_txq_mbufs(struct hinic3_txq *txq);
-- 
2.43.0

