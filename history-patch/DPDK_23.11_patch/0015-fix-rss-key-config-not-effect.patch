From adcb49f8b2ceb74438f6ef1d6e014f99651279c8 Mon Sep 17 00:00:00 2001
From: wangxin679 <wangxin679@h-partners.com>
Date: Mon, 25 Aug 2025 15:31:21 +0800
Subject: [PATCH] fix rss key config not effect

---
 drivers/net/hinic3/hinic3_pmd_ethdev.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/hinic3/hinic3_pmd_ethdev.c b/drivers/net/hinic3/hinic3_pmd_ethdev.c
index bf03d53..52b188f 100644
--- a/drivers/net/hinic3/hinic3_pmd_ethdev.c
+++ b/drivers/net/hinic3/hinic3_pmd_ethdev.c
@@ -2351,13 +2351,13 @@ static int hinic3_rss_hash_update(struct rte_eth_dev *dev,
 	}
 
 	if (rss_conf->rss_key) {
-		err = hinic3_rss_set_hash_key(nic_dev->hwdev, nic_dev->rss_key,
+		err = hinic3_rss_set_hash_key(nic_dev->hwdev, rss_conf->rss_key,
 					      HINIC3_RSS_KEY_SIZE);
 		if (err) {
 			PMD_DRV_LOG(ERR, "Set RSS hash key failed");
 			return err;
 		}
-		memcpy((void *)nic_dev->rss_key, (void *)rss_conf->rss_key, /*lint !e746*/
+		memcpy((void *)nic_dev->rss_key, (void *)rss_conf->rss_key,
 		       (size_t)rss_conf->rss_key_len);
 	}
 
-- 
2.45.1.windows.1

