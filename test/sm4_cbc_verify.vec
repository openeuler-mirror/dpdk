# SPDX-License-Identifier: GPL-2.0
# SM4-CBC verify test vector for dpdk-test-crypto-perf
#
# GM/T 0002-2012 SM4 standard test vector:
#   Key       = 0123456789abcdeffedcba9876543210
#   Plaintext = 0123456789abcdeffedcba9876543210
#   SM4 ECB   = 681edf34d206965e86b3e94f536e4246
#
# CBC with IV=0 means C = SM4_encrypt(P XOR 0) = SM4_encrypt(P) = ECB result
# So ciphertext should be 681edf34d206965e86b3e94f536e4246
#
# Usage:
#   ./build/app/dpdk-test-crypto-perf -l 0-1 --vdev crypto_hns5 -- \
#       --devtype crypto_hns5 --ptest verify \
#       --optype cipher-only \
#       --cipher-algo sm4-cbc --cipher-op encrypt --cipher-key-sz 16 --cipher-iv-sz 16 \
#       --buffer-sz 16 --total-ops 1 --burst-sz 1 \
#       --test-file ../test/sm4_cbc_verify.vec

cipher_key =
0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10

cipher_iv =
0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00

plaintext =
0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10

ciphertext =
0x68, 0x1e, 0xdf, 0x34, 0xd2, 0x06, 0x96, 0x5e,
0x86, 0xb3, 0xe9, 0x4f, 0x53, 0x6e, 0x42, 0x46
