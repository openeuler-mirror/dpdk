diff -ruN '--exclude=.git' '--exclude=build' '--exclude=dependency' '--exclude=*.patch' dpdk-stable-20.11.10/drivers/net/hns5/hns5_lsw.c hns5/drivers/net/hns5/hns5_lsw.c
