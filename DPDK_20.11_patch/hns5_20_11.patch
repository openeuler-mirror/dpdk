+            rule->key_conf.mask.in_dp = rte_be_to_cpu_16(tcp_mask->hdr.dst_port);
+        }
+    }
+
+    tcp_spec = item->spec;
+    rule->key_conf.key.in_sp = rte_be_to_cpu_16(tcp_spec->hdr.src_port);
+    rule->key_conf.key.in_dp = rte_be_to_cpu_16(tcp_spec->hdr.dst_port);
+
+    return 0;
+}
