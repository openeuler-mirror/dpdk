From 9c22ea0a0605a6de8fbc355205023eb6813048d5 Mon Sep 17 00:00:00 2001
From: xiaobai <chenyi19990512@163.com>
Date: Tue, 20 May 2025 10:15:47 +0800
Subject: [PATCH] Add count mbox info telemetry tool for DPDK 20.11

---
 drivers/net/hinic3/base/hinic3_pmd_mbox.c |  2 +
 drivers/net/hinic3/base/hinic3_pmd_mbox.h |  3 +
 drivers/net/hinic3/hinic3_pmd_telemetry.c | 97 +++++++++++++++++++++++
 drivers/net/hinic3/hinic3_pmd_telemetry.h | 23 ++++++
 drivers/net/hinic3/meson.build            |  1 +
 lib/librte_telemetry/telemetry.c          | 52 +++++++++++-
 lib/librte_telemetry/telemetry_data.c     |  3 +-
 7 files changed, 177 insertions(+), 4 deletions(-)
 create mode 100644 drivers/net/hinic3/hinic3_pmd_telemetry.c
 create mode 100644 drivers/net/hinic3/hinic3_pmd_telemetry.h

diff --git a/drivers/net/hinic3/base/hinic3_pmd_mbox.c b/drivers/net/hinic3/base/hinic3_pmd_mbox.c
index 89d81df..ea05e83 100644
--- a/drivers/net/hinic3/base/hinic3_pmd_mbox.c
+++ b/drivers/net/hinic3/base/hinic3_pmd_mbox.c
@@ -795,6 +795,7 @@ static int hinic3_mbox_to_func(struct hinic3_mbox *func_to_func,
 		goto send_err;
 	}
 
+	func_to_func->mbox_send_cnt++;
 	time = msecs_to_jiffies(timeout ? timeout : HINIC3_MBOX_COMP_TIME);
 	aeq = &func_to_func->hwdev->aeqs->aeq[HINIC3_MBOX_RSP_MSG_AEQ];
 	err = hinic3_aeq_poll_msg(aeq, time, NULL);
@@ -805,6 +806,7 @@ static int hinic3_mbox_to_func(struct hinic3_mbox *func_to_func,
 		goto send_err;
 	}
 
+	func_to_func->mbox_ack_cnt++;
 	if (mod != mbox_for_resp->mod || cmd != mbox_for_resp->cmd) {
 		PMD_DRV_LOG(ERR, "Invalid response mbox message, mod: 0x%x, cmd: 0x%x, expect mod: 0x%x, cmd: 0x%x\n",
 			    mbox_for_resp->mod, mbox_for_resp->cmd, mod, cmd);
diff --git a/drivers/net/hinic3/base/hinic3_pmd_mbox.h b/drivers/net/hinic3/base/hinic3_pmd_mbox.h
index 2cb97c8..225c1d3 100644
--- a/drivers/net/hinic3/base/hinic3_pmd_mbox.h
+++ b/drivers/net/hinic3/base/hinic3_pmd_mbox.h
@@ -177,6 +177,9 @@ struct hinic3_mbox {
 	enum mbox_event_state event_flag;
 	/* Lock for mbox event flag */
 	rte_spinlock_t mbox_lock;
+
+	u64 mbox_send_cnt;
+	u64 mbox_ack_cnt;
 };
 
 int hinic3_mbox_func_aeqe_handler(void *handle, u8 *header,
diff --git a/drivers/net/hinic3/hinic3_pmd_telemetry.c b/drivers/net/hinic3/hinic3_pmd_telemetry.c
new file mode 100644
index 0000000..afa6907
--- /dev/null
+++ b/drivers/net/hinic3/hinic3_pmd_telemetry.c
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright(c) 2025 Huawei Technologies Co., Ltd
+ */
+
+#include <rte_telemetry.h>
+#include "base/hinic3_compat.h"
+#include "base/hinic3_pmd_mgmt.h"
+#include "base/hinic3_pmd_hwdev.h"
+#include "base/hinic3_pmd_mbox.h"
+#include "base/hinic3_pmd_nic_cfg.h"
+#include "hinic3_pmd_ethdev.h"
+#include "hinic3_pmd_telemetry.h"
+
+static int
+hinic3_get_mbox_info(struct rte_eth_dev *eth_dev, struct mbox_cnt_info *mbox_cnt)
+{
+    u32 i;
+
+    struct rte_pci_device *pci_dev = RTE_ETH_DEV_TO_PCI(eth_dev);
+    if (pci_dev == NULL) {
+        PMD_DRV_LOG(ERR, "Get pci device failed");
+        return -1;
+    }
+
+    struct hinic3_nic_dev *nic_dev = HINIC3_ETH_DEV_TO_PRIVATE_NIC_DEV(eth_dev);
+    if (nic_dev == NULL) {
+        PMD_DRV_LOG(ERR, "Get nic device failed.");
+        return -1;
+    }
+
+    i = mbox_cnt->func_num;
+    mbox_cnt->func_num++;
+    snprintf(mbox_cnt->func_info[i].bus_info, sizeof(mbox_cnt->func_info[i].bus_info), "%.4x_%.2x_%.2x_%x",
+        pci_dev->addr.domain, pci_dev->addr.bus, pci_dev->addr.devid, pci_dev->addr.function);
+
+    mbox_cnt->func_info[i].send_cnt = nic_dev->hwdev->func_to_func->mbox_send_cnt;
+    mbox_cnt->func_info[i].ack_cnt = nic_dev->hwdev->func_to_func->mbox_ack_cnt;
+
+    return 0;
+}
+
+static int
+hinic3_telemetry_info(const char *cmd, const char *params, struct rte_tel_data *d)
+{
+    struct rte_eth_dev *eth_dev = NULL;
+    struct rte_tel_data *i_data = NULL;
+    struct rte_tel_data *func_data = NULL;
+    struct hinic3_nic_dev *nic_dev = NULL;
+    struct mbox_cnt_info mbox_cnt;
+    u8 n_ports, i, err;
+
+    memset(&mbox_cnt, 0, sizeof(struct mbox_cnt_info));
+
+    for (i = 0; i < RTE_MAX_ETHPORTS; i++) {
+        /* Skip if port is unused */
+        if (!rte_eth_dev_is_valid_port(i))
+            continue;
+
+        eth_dev = &rte_eth_devices[i];
+        if (eth_dev) {
+            err = hinic3_get_mbox_info(eth_dev, &mbox_cnt);
+            if (err) {
+                PMD_DRV_LOG(ERR, "Get mbox info failed.");
+                return -1;
+            }
+        }
+    }
+
+    rte_tel_data_start_dict(d);
+    rte_tel_data_add_dict_int(d, "func_num", mbox_cnt.func_num);
+
+    i_data = rte_tel_data_alloc();
+    if (i_data == NULL)
+        return -ENOMEM;
+
+    rte_tel_data_start_dict(i_data);
+    for (i = 0; i < mbox_cnt.func_num; i++) {
+        func_data = rte_tel_data_alloc();
+        if (func_data == NULL)
+            return -ENOMEM;
+
+        rte_tel_data_start_dict(func_data);
+        rte_tel_data_add_dict_int(func_data, "send_cnt", mbox_cnt.func_info[i].send_cnt);
+        rte_tel_data_add_dict_int(func_data, "ack_cnt",mbox_cnt.func_info[i].ack_cnt);
+        rte_tel_data_add_dict_container(i_data, mbox_cnt.func_info[i].bus_info, func_data, 0);
+    }
+
+    rte_tel_data_add_dict_container(d, "func_info", i_data, 0);
+
+    return 0;
+}
+
+RTE_INIT(hinic3_init_telemetry)
+{
+    rte_telemetry_register_cmd("/hinic3/mbox_cnt", hinic3_telemetry_info,
+                               "Returns mbox send and ack count information");
+}
diff --git a/drivers/net/hinic3/hinic3_pmd_telemetry.h b/drivers/net/hinic3/hinic3_pmd_telemetry.h
new file mode 100644
index 0000000..de093cd
--- /dev/null
+++ b/drivers/net/hinic3/hinic3_pmd_telemetry.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright(c) 2025 Huawei Technologies Co., Ltd
+ */
+
+#ifndef _HINIC3_PMD_TELEMETRY_H_
+#define _HINIC3_PMD_TELEMETRY_H_
+
+#define HINIC_PF_MAX_SIZE 16
+#define HINIC_VF_MAX_SIZE 4096
+#define BUSINFO_LEN 32
+
+struct func_mbox_cnt_info {
+    char bus_info[BUSINFO_LEN];
+    u64 send_cnt;
+    u64 ack_cnt;
+};
+
+struct mbox_cnt_info {
+    struct func_mbox_cnt_info func_info[HINIC_PF_MAX_SIZE + HINIC_VF_MAX_SIZE];
+    u32 func_num;
+};
+
+#endif /* _HINIC3_PMD_TELEMETRY_H_ */
diff --git a/drivers/net/hinic3/meson.build b/drivers/net/hinic3/meson.build
index 0085301..6c802a0 100644
--- a/drivers/net/hinic3/meson.build
+++ b/drivers/net/hinic3/meson.build
@@ -37,6 +37,7 @@ sources = files(
  	'hinic3_pmd_flow.c',
 	'hinic3_pmd_nic_io.c',
 	'hinic3_pmd_fdir.c',
+	'hinic3_pmd_telemetry.c',
 	)
 
 if arch_subdir == 'arm' and dpdk_conf.get('RTE_ARCH_64')
diff --git a/lib/librte_telemetry/telemetry.c b/lib/librte_telemetry/telemetry.c
index 3f80d72..77b87e4 100644
--- a/lib/librte_telemetry/telemetry.c
+++ b/lib/librte_telemetry/telemetry.c
@@ -141,11 +141,15 @@ container_to_json(const struct rte_tel_data *d, char *out_buf, size_t buf_len)
 	size_t used = 0;
 	unsigned int i;
 
-	if (d->type != RTE_TEL_ARRAY_U64 && d->type != RTE_TEL_ARRAY_INT
-			&& d->type != RTE_TEL_ARRAY_STRING)
+	if (d->type != RTE_TEL_DICT && d->type != RTE_TEL_ARRAY_U64 &&
+		d->type != RTE_TEL_ARRAY_INT && d->type != RTE_TEL_ARRAY_STRING)
 		return snprintf(out_buf, buf_len, "null");
 
-	used = rte_tel_json_empty_array(out_buf, buf_len, 0);
+	if (d->type == RTE_TEL_DICT)
+		used = rte_tel_json_empty_obj(out_buf, buf_len, 0);
+	else
+		used = rte_tel_json_empty_array(out_buf, buf_len, 0);
+
 	if (d->type == RTE_TEL_ARRAY_U64)
 		for (i = 0; i < d->data_len; i++)
 			used = rte_tel_json_add_array_u64(out_buf,
@@ -161,6 +165,48 @@ container_to_json(const struct rte_tel_data *d, char *out_buf, size_t buf_len)
 			used = rte_tel_json_add_array_string(out_buf,
 				buf_len, used,
 				d->data.array[i].sval);
+	if (d->type == RTE_TEL_DICT)
+		for (i = 0; i < d->data_len; i++) {
+			const struct tel_dict_entry *v = &d->data.dict[i];
+			switch (v->type) {
+			case RTE_TEL_STRING_VAL:
+				used = rte_tel_json_add_obj_str(out_buf,
+						buf_len, used,
+						v->name, v->value.sval);
+				break;
+			case RTE_TEL_INT_VAL:
+				used = rte_tel_json_add_obj_int(out_buf,
+						buf_len, used,
+						v->name, v->value.ival);
+				break;
+			case RTE_TEL_U64_VAL:
+				used = rte_tel_json_add_obj_u64(out_buf,
+						buf_len, used,
+						v->name, v->value.u64val);
+				break;
+			case RTE_TEL_CONTAINER:
+			{
+				char *temp = malloc(buf_len);
+				if (temp == NULL)
+					break;
+				*temp = '\0';  /* ensure valid string */
+
+				const struct container *cont =
+						&v->value.container;
+				if (container_to_json(cont->data,
+						temp, buf_len) != 0)
+					used = rte_tel_json_add_obj_json(
+							out_buf,
+							buf_len, used,
+							v->name, temp);
+				if (!cont->keep)
+					rte_tel_data_free(cont->data);
+				free(temp);
+				break;
+			}
+			}
+		}
+
 	return used;
 }
 
diff --git a/lib/librte_telemetry/telemetry_data.c b/lib/librte_telemetry/telemetry_data.c
index 77b0fe0..e14ae3c 100644
--- a/lib/librte_telemetry/telemetry_data.c
+++ b/lib/librte_telemetry/telemetry_data.c
@@ -155,7 +155,8 @@ rte_tel_data_add_dict_container(struct rte_tel_data *d, const char *name,
 
 	if (d->type != RTE_TEL_DICT || (val->type != RTE_TEL_ARRAY_U64
 			&& val->type != RTE_TEL_ARRAY_INT
-			&& val->type != RTE_TEL_ARRAY_STRING))
+			&& val->type != RTE_TEL_ARRAY_STRING
+			&& val->type != RTE_TEL_DICT))
 		return -EINVAL;
 	if (d->data_len >= RTE_TEL_MAX_DICT_ENTRIES)
 		return -ENOSPC;
