+
+    for (i = 0; i < PCAP_MAX_CAP_TASK; i++) {
+        cap_task = task_mgr->cap_task_list[i];
+        if (!cap_task)
+            continue;
+
+        if (cap_task->stop_flag || (cap_task->remain_count == 0))
+            continue;
+
+        if (cap_task->pcap_id != pcap_id)
+            continue;
+
+        cap_task->ref_cnt++;
+        if (task_mirror) {
+            task_mirror->stop_flag = cap_task->stop_flag;
