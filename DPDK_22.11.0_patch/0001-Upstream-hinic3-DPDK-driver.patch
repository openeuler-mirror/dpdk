+        hinic3_set_port_list_init(false);
+    } else {
+        ret = hinic3_smart_vf_flavor_add();
+        if (ret != 0) {
+            HINIC3_LOG(ERR, VPORT, "hinic3_smart_vf_flavor_add err, ret is %d", ret);
+            return -1;
+        }
+    }
+
+    return 0;
+}
