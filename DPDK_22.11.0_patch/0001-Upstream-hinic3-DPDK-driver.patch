+    struct hinic3_dev_node *next = NULL;
+
+    LIST_FOR_EACH_SAFE(iter, next, node, list) {
+        hinic3_list_remove(&(iter->node));
+        hinic3_free(iter);
+        iter = NULL;
+    }
