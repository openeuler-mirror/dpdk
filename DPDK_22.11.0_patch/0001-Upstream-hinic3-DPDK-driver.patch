@@ -0,0 +1,55 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ * Copyright(c) 2021 Huawei Technologies Co., Ltd
+ */
+
+#ifndef HINIC3_DFX_PORT_H
+#define HINIC3_DFX_PORT_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "rte_ethdev.h"
+#include "hinic3_util.h"
+#include "hinic3_command.h"
+#include "hinic3_option.h"
+#include "hinic3_provider.h"
+#include "hinic3_ds.h"
+
+#define HINIC3_DFX_GLOABL_ALLOC_MEM_MAX_SIZE  (0x20000)
+#define HINIC3_CMD_MAX_LENGTH                 2048
+#define HINIC3_NETDEV_NAME_MAX_LENGTH         512
+#define HINIC3_BOND_SLAVE_POSTION_INFO        1
+#define HINIC3_BOND_SLAVE_NUM                 4
+#define HINIC3_VPORT_TYPE_SHIFT               12
