diff --git a/drivers/net/hinic3/src/hinic3_flows/hinic3_flow_query/hinic3_flow_agent_sync_stats.c b/drivers/net/hinic3/src/hinic3_flows/hinic3_flow_query/hinic3_flow_agent_sync_stats.c
