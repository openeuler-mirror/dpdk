+void
+hinic3_bond_flow_ops_destroy(void)
+{
+    if (g_hinic3_pf_flow_ops == NULL)
+        return;
+
+    hinic3_free(g_hinic3_pf_flow_ops);
+
+    g_hinic3_pf_flow_ops = NULL;
