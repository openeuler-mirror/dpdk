+    {"hinic3-packet",  HINIC3_LOG_TYPE_UP, HINIC3_LOG_PACKET, RTE_LOG_INFO},
+    {"hinic3-driver-vport",   HINIC3_LOG_TYPE_DRIVER,  HINIC3_DRIVER_LOG_VPORT,  RTE_LOG_INFO},
+    {"hinic3-driver-bond",    HINIC3_LOG_TYPE_DRIVER,  HINIC3_DRIVER_LOG_BOND,   RTE_LOG_INFO},
+    {"hinic3-driver-flow",    HINIC3_LOG_TYPE_DRIVER,  HINIC3_DRIVER_LOG_FLOW,   RTE_LOG_INFO},
+    {"hinic3-driver-bum",     HINIC3_LOG_TYPE_DRIVER,  HINIC3_DRIVER_LOG_BUM,    RTE_LOG_INFO},
+    {"hinic3-driver-qos",     HINIC3_LOG_TYPE_DRIVER,  HINIC3_DRIVER_LOG_QOS,    RTE_LOG_INFO},
+    {"hinic3-driver-chip",    HINIC3_LOG_TYPE_DRIVER,  HINIC3_DRIVER_LOG_CHIP,   RTE_LOG_INFO},
+    {"hinic3-driver-packet",  HINIC3_LOG_TYPE_DRIVER,  HINIC3_DRIVER_LOG_PACKET, RTE_LOG_INFO},
