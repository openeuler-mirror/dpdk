+static bool
+pcap_timeout_check(uint64_t start_tsc, uint64_t timout_ms)
+{
+    uint64_t now;
+
+    now = rte_rdtsc();
+    if ((now - start_tsc) > timout_ms * g_ticks_per_ms)
+        return true;
+
+    return false;
+}
