+    if (queue_id >= data->nb_rx_queues) {
+        HINIC3_LOG(ERR, VPORT, "queue index invalid, max queue is:%u", data->nb_rx_queues);
+        return;
+    }
+    rxq = data->rx_queues[queue_id];
+    if (rxq != NULL) {
+        hinic3_vf_release_upcall_queue(vf_dev, queue_id);
+        hinic3_rte_free(rxq);
+        vf_dev->upcall_queue.rx_queue[queue_id] = NULL;
+        data->rx_queues[queue_id] = NULL;
+    }
