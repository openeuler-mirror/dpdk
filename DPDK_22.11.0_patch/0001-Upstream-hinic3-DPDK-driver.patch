+        return -EINVAL;
+
+    struct rte_eth_dev_data *data = dev->data;
+    struct rte_eth_link *dev_link = &data->dev_link;
+
+    dev_link->link_status = RTE_ETH_LINK_DOWN;
+    data->dev_started = HINIC3_DEV_STATE_STOP;
