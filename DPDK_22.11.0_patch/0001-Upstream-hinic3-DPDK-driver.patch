+    if (ret != 0) {
+        HINIC3_LOG(ERR, AGENT, "Agent_construct: pf enable failed, ret is %d.", ret);
+        return -1;
+    }
+
+    if (hinic3_device_mode_get() == DPU_MODE) {
+        (void)hinic3_solution_vitrio_wait();
+    }
+
+    (void)hinic3_global_cfg_set_when_restart();
+
+    return 0;
+}
