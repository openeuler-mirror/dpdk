diff --git a/drivers/net/hinic3/src/hinic3_flows/hinic3_flow_format/hinic3_flow_format.c b/drivers/net/hinic3/src/hinic3_flows/hinic3_flow_format/hinic3_flow_format.c
new file mode 100644
index 0000000..87c9a70
--- /dev/null
+++ b/drivers/net/hinic3/src/hinic3_flows/hinic3_flow_format/hinic3_flow_format.c
@@ -0,0 +1,549 @@
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2023-2024. All rights reserved.
+ * Description:rte flow format to string
+ * Create: 2023-10-07
+ */
+#include "hinic3_flow_format.h"
+#include "hinic3_ui_string.h"
