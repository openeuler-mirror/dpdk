+    uint64_t max_rate, uint64_t max_burst, uint64_t min_rate, uint64_t min_burst);
+
+/**
+ * Set the QoS limiting for a net.
+ *
+ * @param dir             0-ingress(net -> NIC, net tx), 1-egress(NIC -> net, net rx)
+ * @param type            0-bandwidth, 1-pps
