+#endif
+
+enum command_error {
+    TIMEOUT_ERROR = -2,
+    EXECUTION_ERROR = -3,
+};
+
+static void
+hinic3_show_command_version_info(void)
+{
+    printf("%2s%s\n", HINIC3_UI_INDENT_SPACE, HINIC3_AGENT_COMPONENT_NAME);
+    printf("%2s%s\n", HINIC3_UI_INDENT_SPACE, HINIC3_COMMAND_FEATURE_NAME);
