+static int hinic3_parse_vpda_feature(struct rte_cfgfile *inifile)
+{
+    char* end_ptr = NULL;
+    uint64_t vpda_feature = 0;
+    const char *vdpa_feature_str = rte_cfgfile_get_entry(inifile, PORT_SECTION, PORT_SECTION_VDPA_FEATURE_KEY);
