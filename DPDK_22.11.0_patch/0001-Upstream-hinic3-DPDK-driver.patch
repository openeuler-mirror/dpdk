+#define CONNECT_FAILED_TIMEOUT 10
+#define RETRY_TIMES 3
+#define HINIC3_DEFAULT_MAJOR_VERSION_STRING "(null)"
+#define HINIC3_DEFAULT_SUB_VERSION_STRING "(null)"
+
+#ifdef BUILD_MAJOR_VERSION
