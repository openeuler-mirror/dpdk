+int hinic3_get_pattern(struct rte_flow_item *pattern, struct input_key *item_key)
+{
+    int i = 0;
+    int ret = 0;
+    for (i = 0; i < HINIC3_INPUT_ITEM_MAX_NUM; i++) {
+        ret = g_get_query_pattern[i](&pattern[i], item_key);
+        if (ret != 0) {
+            hinic3_query_pattern_free(pattern);
+            return -1;
+        }
+    }
+    return 0;
+}
