+int hinic3_flow_init(void)
+{
+    struct hinic3_flow_capability cap;
+    memset(&cap, 0, sizeof(cap));
+
+    if (hinic3_flow_get_capability(&cap) != 0) {
+        HINIC3_LOG(ERR, FLOW, "Failed to get hiovs capability");
+        return -1;
+    }
+
+    if (cap.rx_thread_num > HINIC3_RX_THREAD_MAX) {
+        HINIC3_LOG(ERR, FLOW, "flow agent rx thread num: %u is greater than max num: %d!", cap.rx_thread_num,
+            HINIC3_RX_THREAD_MAX);
+        return -1;
+    }
+
+    return 0;
+}
