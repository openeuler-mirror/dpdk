+static inline int hinic3_cmd_flow_get_maxflows(uint32_t *max_flow_cnt)
+{
+    struct hinic3_flow_dump_cmd *ops = hinic3_cmd_get_flow_dump_ops();
+    if (ops == NULL || ops->hinic3_flow_get_maxflows_ops == NULL)
+        return -1;
+    return ops->hinic3_flow_get_maxflows_ops(max_flow_cnt);
+}
