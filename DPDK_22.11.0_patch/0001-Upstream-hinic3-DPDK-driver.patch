+{
+    hinic3_ds_put_format(ds, "%2sc_k_s_rsvd0_ver:%u\n", HINIC3_UI_INDENT_SPACE, key->tunnel.gre.c_rsvd0_ver);
+    hinic3_ds_put_format(ds, "%2sprotocol:%X\n", HINIC3_UI_INDENT_SPACE, htons(key->tunnel.gre.protocol));
