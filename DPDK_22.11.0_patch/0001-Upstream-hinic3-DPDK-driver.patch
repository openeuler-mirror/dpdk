+#define MULTI_QOS_MASK_TX (1ULL << 0)
+#define MULTI_QOS_MASK_RX (1ULL << 1)
+#define MULTI_QOS_ARG_NUMS 2
+#define MULTI_PPS_QOS_SPEACE_NUMS 6
+#define MULTI_KBPS_QOS_SPEACE_NUMS 5
