+    } else {
+        hinic3_ds_put_format(&ds, HINIC3_UI_LEADING_SIGN_ERROR "Invalid number of parameters.\n");
+        ret = -1;
+    }
+
+    if (ret != 0) {
+        *(int *)aux = -1;
+        hinic3_command_reply_error(conn, hinic3_ds_cstr(&ds));
+    } else {
+        *(int *)aux = 0;
+        hinic3_command_reply(conn, hinic3_ds_cstr(&ds));
+    }
+    hinic3_ds_destroy(&ds);
+}
