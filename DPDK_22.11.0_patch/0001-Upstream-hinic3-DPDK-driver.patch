+static inline int hinic3_cmd_flow_dump_done(void *state)
+{
+    struct hinic3_flow_dump_cmd *ops = hinic3_cmd_get_flow_dump_ops();
+    if (ops == NULL || ops->hinic3_flow_dump_done_ops == NULL)
