+int hinic3_input_key_parse(struct unixctl_conn *conn, struct pcap_key_t *cap_key, int argc,
+    const char *argv[], struct ds *ds)
+{
+    int ret;
+    int work_argc = argc - 1;
+    int i = 1;
+    const char **work_argv = argv;
+
+    memset(cap_key, 0, sizeof(struct pcap_key_t));
+    if (work_argc < INPUT_KEY_MIN_NUM || work_argc > INPUT_KEY_MAX_NUM) {
+        HINIC3_LOG(ERR, FLOW, "Input parameter nums error.\n");
+        hinic3_ds_put_format(ds, "%sInput parameter nums error.\n", HINIC3_UI_LEADING_SIGN_ERROR);
+        return -1;
+    }
+
+    while (i < work_argc) {
+        ret = hinic3_sub_key_parse(conn, cap_key, (char *)work_argv[i], (char *)work_argv[i + 1], ds);
+        if (ret != 0) {
+            HINIC3_LOG(ERR, FLOW, "key_parse error\n");
+            return -1;
+        }
+        get_input_key(work_argv[i], cap_key);
+        i += ARGC_ADD_DOUBLE;
+    }
+
+    return 0;
+}
