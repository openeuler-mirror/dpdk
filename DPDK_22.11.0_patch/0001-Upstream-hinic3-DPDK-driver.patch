+
+#include "hinic3_flow_agent_public.h"
+
+#define HINIC3_STATS_SYNC_INTERVAL 1500 /* 1.5s */
+#define HINIC3_MAX_STATS_SYNC_INTERVAL 3000 /* 3.0s */
+#define HINIC3_EVERY_STATS_SYNC_INTERVAL 100 /* 0.1s */
