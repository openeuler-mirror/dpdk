+    hwoff/query-offloaded-flow
+    hwoff/del-flow-by-ufid
+    hwoff/dump-meter
+    hwoff/dump-flow-qos-loss
+    -h
+    -v
+)
+
+RUN_TIME_MODE_OPTS=(
+    hwoff/dump-port-qos-loss
+    hwoff/show-meter
+    hwoff/show-policy
