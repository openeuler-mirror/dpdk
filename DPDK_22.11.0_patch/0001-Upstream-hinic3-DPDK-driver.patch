diff --git a/drivers/net/hinic3/src/hinic3_flows/hinic3_flow_mirror/hinic3_flow_mirror.c b/drivers/net/hinic3/src/hinic3_flows/hinic3_flow_mirror/hinic3_flow_mirror.c
