+{
+    int i;
+
+    for (i = 0; i < HINIC3_PORT_API_MAX; ++i) {
+        if (api_index == g_port_api_arr[i].api_index) {
+            return g_port_api_arr[i].api_name;
+        }
+    }
+    return NULL;
+}
