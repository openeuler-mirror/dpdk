+void
+hinic3_bond_flow_ops_construct(void)
+{
+    struct rte_flow_ops *flow_ops = hinic3_calloc(1, sizeof(struct rte_flow_ops), HINIC3_PORTS);
+    if (flow_ops == NULL)
+        return;
+
+    rte_flow_ops_set_validate(flow_ops, hinic3_eth_flow_validate);
+    rte_flow_ops_set_create(flow_ops, hinic3_eth_flow_create);
+    rte_flow_ops_set_destroy(flow_ops, hinic3_eth_flow_destroy);
+    rte_flow_ops_set_flush(flow_ops, hinic3_eth_flow_flush);
+    rte_flow_ops_set_query(flow_ops, hinic3_eth_flow_query);
+    rte_flow_ops_set_dev_dump(flow_ops, hinic3_eth_flow_dev_dump);
+    rte_flow_ops_tunnel_decap_set(flow_ops, hinic3_flow_tunnel_decap_set);
+    rte_flow_ops_flow_dump_start(flow_ops, hinic3_eth_flow_dump_start);
+    rte_flow_ops_flow_dump_next(flow_ops, hinic3_eth_flow_dump_next);
+    rte_flow_ops_flow_dump_done(flow_ops, hinic3_eth_flow_dump_done);
+    g_hinic3_pf_flow_ops = flow_ops;
+}
