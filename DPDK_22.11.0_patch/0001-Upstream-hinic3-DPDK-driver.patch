diff --git a/drivers/net/hinic3/src/hinic3_flows/hinic3_emc_dump/hinic3_flow_emc_dump.c b/drivers/net/hinic3/src/hinic3_flows/hinic3_emc_dump/hinic3_flow_emc_dump.c
