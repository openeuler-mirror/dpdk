+
+    while ((hinic3_cmd_flow_dump_next(state, f)) == 0 && dump_flows_count <= HINIC3_DUMP_FLOWS_MAX_ONCE)
+    {
+        hinic3_agent_flow_format_output(table_id_input, f, ds);
