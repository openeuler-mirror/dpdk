+            return ret;
+        }
+
+        ret = hinic3_flexda_flow_parse_action_info(&table_info->action_list);
+        if (ret != 0) {
+            HINIC3_LOG(ERR, FLOW, "hinic3_flexda_flow_parse_config_info: hinic3_flexda_flow_parse_action_info failed ");
