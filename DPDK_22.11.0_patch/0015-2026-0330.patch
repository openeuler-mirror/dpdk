+
+    session_info->key.tunnel.vxlan_gpe_shim.dst_port = udp->src_port;
+    session_info->key.tunnel.vxlan_gpe_shim.src_port = udp->dst_port;
+    session_info->ip_type_flag |= HINIC3_FLG_MIRROR_UDP;
+
+    *end_itr = itr;
