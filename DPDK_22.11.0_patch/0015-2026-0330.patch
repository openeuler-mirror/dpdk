+    {
+        return g_hwoff_flexda_flow_ops_adapter.set_query(flow_ops, arg);
+    }
+
+    /* flexda ovs adapter */
+    /*
+     * 函 数 名 : hovs_flexda_init_adapter
+     * 功能描述 : 初始化适配层
+     *  * 输入参数 : api,DPAK开放的功能；
