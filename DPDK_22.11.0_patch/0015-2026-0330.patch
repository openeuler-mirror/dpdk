+    if (ret != 0 || if_index > UINT16_MAX) {
+        HINIC3_LOG(ERR, VPORT, "hwoff/%s failed, device ifindex error", cmd);
+        return -1;
+    } else {
+        *port_id = (uint16_t)if_index;
+    }
+
+    return 0;
+}
