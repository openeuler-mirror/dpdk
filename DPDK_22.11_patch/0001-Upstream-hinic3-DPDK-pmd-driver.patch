+struct cfg_mgmt_info;
+
+struct hinic3_hwif;
+struct hinic3_aeqs;
+struct hinic3_mbox;
+struct hinic3_msg_pf_to_mgmt;
+
+#define MGMT_VERSION_MAX_LEN		32
+
+enum hinic3_set_arm_type {
+	HINIC3_SET_ARM_CMDQ,
+	HINIC3_SET_ARM_SQ,
+	HINIC3_SET_ARM_TYPE_NUM
+};
+
