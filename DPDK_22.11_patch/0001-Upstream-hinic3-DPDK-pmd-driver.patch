+/*
+ * string_tol - string to uint32_t
+ * @nptr: the string
+ * @value: the output value
+ */
+static __inline__ int string_toui(const char *nptr, int base, uint32_t *value)
+{
+    char *endptr = NULL;
+    long int tmp_value;
+
+    tmp_value = strtol(nptr, &endptr, base);
+    if ((*endptr != 0) || tmp_value >= 0x7FFFFFFF || tmp_value < 0) {
+        return -UDA_EINVAL;
+    }
+    *value = (uint32_t)tmp_value;
+    return UDA_SUCCESS;
