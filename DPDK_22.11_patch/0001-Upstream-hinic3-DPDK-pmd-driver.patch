+int hinic3_add_tcam_rule(void *hwdev, struct hinic3_tcam_cfg_rule *tcam_rule, u8 tcam_rule_type);
+
+/**
+ * Del tcam rules
+ *
+ * @param[in] hwdev
+ *   Device pointer to hwdev
+ * @param[in] index
+ *   Tcam rule index
+ * @param[in] tcam_rule_type
+ *
+ * @retval zero : Success
+ * @retval non-zero : Failure
