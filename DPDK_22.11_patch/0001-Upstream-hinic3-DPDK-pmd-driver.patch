+	HINIC3_RX_BUF_SIZE_1_5K = 0x600,
+	HINIC3_RX_BUF_SIZE_2K = 0x800,
+	HINIC3_RX_BUF_SIZE_3K = 0xC00,
+	HINIC3_RX_BUF_SIZE_4K = 0x1000,
+	HINIC3_RX_BUF_SIZE_8K = 0x2000,
+	HINIC3_RX_BUF_SIZE_16K = 0x4000,
+};
+
+struct hinic3_cmd_msix_config {
+	u8  status;
+	u8  version;
+	u8  rsvd0[6];
+
+	u16 func_id;
