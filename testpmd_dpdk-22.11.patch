+            .vxlan.data_offset = 0,
+        };
+
+        hwoff_encap_vxlan_apply(&data, &vxlan_param->vxlan_encap, &cfg);
+        for (int i = 0; i < nb_rx; i++) {
+            hwoff_vxlan_ipv4_head_encap(pkts_burst[i], &data);
