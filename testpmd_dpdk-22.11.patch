+        .vxlan.ipv4.ttl = 64,
+    },
+    .bond_id = 65535,
+};
+
+struct hwoff_vtep_info *hwoff_get_vxlan_encap_info(void)
+{
+    return &g_hwoff_vxlan_encap;
+}
+
+static int hwoff_parse_vtep_eth(struct rte_cfgfile *cfg, struct rte_table_action_encap_params *vtep)
+{
+    int ret = 0;
+    const char *smac = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_SMAC);
+    if (smac == NULL) {
+        printf("hwoff offload, get smac failed\n");
+        return -1;
+    }
+
+    const char *dmac = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_DMAC);
+    if (dmac == NULL) {
+        printf("hwoff offload, get dmac failed\n");
+        return -1;
+    }
+
+    ret = rte_ether_unformat_addr(smac, &vtep->vxlan.ether.sa);
+    if (ret != 0) {
+        printf("hwoff offload, translate smac failed\n");
+        return -1;
+    }
+
+    ret = rte_ether_unformat_addr(dmac, &vtep->vxlan.ether.da);
+    if (ret != 0) {
+        printf("hwoff offload, translate dmac failed\n");
+        return -1;
+    }
+
+    return 0;
+}
+
+static int hwoff_parse_vtep_ip(struct rte_cfgfile *cfg, struct rte_table_action_encap_params *vtep)
+
+{
+    int ret = 0;
+    int af = 0;
+    void *src = NULL;
+    void *dst = NULL;
+    const char *sip = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_SIP);
+    if (sip == NULL) {
+        printf("hwoff offload, get sip failed\n");
+        return -1;
+    }
+
+    // Ipv4
+    af = AF_INET;
+    src = &vtep->vxlan.ipv4.sa;
+    dst = &vtep->vxlan.ipv4.da;
+
+    ret = inet_pton(af, sip, src);
+    if (ret != 1) {
+        printf("hwoff offload, translate sip failed\n");
+        return -1;
+    }
+
+    const char *dip = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_DIP);
+    if (dip == NULL) {
+        printf("hwoff offload, get dip failed\n");
+        return -1;
+    }
+    ret = inet_pton(af, dip, dst);
+    if (ret != 1) {
+        printf("hwoff offload, translate sip failed\n");
+        return -1;
+    }
+    return 0;
+}
+
+static int hwoff_parse_vtep_port(struct rte_cfgfile *cfg, struct rte_table_action_encap_params *vtep)
+{
+    const char *sport = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_SPORT);
+    if (sport == NULL) {
+        printf("hwoff offload, get sport failed\n");
+        return -1;
+    }
+
+    const char *dport = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_DPORT);
+    if (dport == NULL) {
+        printf("hwoff offload, get dport failed\n");
+        return -1;
+    }
+
+    vtep->vxlan.udp.sp = atoi(sport);
+    vtep->vxlan.udp.dp = atoi(dport);
+    return 0;
+}
+
+static int hwoff_parse_vetp_tunnel_info(struct rte_table_action_encap_params *tunnel, portid_t port_id)
+{
+    if (g_hwoff_vtep_set == true) {
+        return 0;
+    }
+
+    char *file = HWOFF_VTEP_INFO;
+    int ret = 0;
+
+    struct rte_cfgfile *cfg = rte_cfgfile_load(file, 0);
+    if (cfg == NULL) {
+        printf("hwoff offload, open vtep cfg file failed\n");
+        return -1;
+    }
+
+    const char *ip_type = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_TYPE);
+    if (ip_type == NULL) {
+        printf("hwoff offload, get vtep type failed\n");
+        rte_cfgfile_close(cfg);
+        return -1;
+    }
+
+    int ip = atoi(ip_type);
+    if (ip == 0) { // 1 ipv4, 2 ipv6
+        printf("hwoff offload, translate vtep type failed\n");
+        rte_cfgfile_close(cfg);
+        return -1;
+    }
+
+    ret = hwoff_parse_vtep_eth(cfg, tunnel);
+    if (ret != 0) {
+        printf("hwoff offload, parse vtep mac failed\n");
+        rte_cfgfile_close(cfg);
+    }
+
+    ret = hwoff_parse_vtep_ip(cfg, tunnel);
+    if (ret != 0) {
+        rte_cfgfile_close(cfg);
+        return -1;
+    }
+
+    ret = hwoff_parse_vtep_port(cfg, tunnel);
+    if (ret != 0) {
+        rte_cfgfile_close(cfg);
+        return -1;
+    }
+
+    const char *vni = rte_cfgfile_get_entry(cfg, HWOFF_VTEP_SECTION, HWOFF_VTEP_VNI);
+    if (vni == NULL) {
+        printf("hwoff offload, get vni failed\n");
+        rte_cfgfile_close(cfg);
+        return -1;
+    }
+
+    tunnel->vxlan.vxlan.vni = atoi(vni);
+    g_hwoff_vxlan_encap.vxlan_encap.vxlan.ipv4.sa = htonl(g_hwoff_vxlan_encap.vxlan_encap.vxlan.ipv4.sa);
+    g_hwoff_vxlan_encap.vxlan_encap.vxlan.ipv4.da = htonl(g_hwoff_vxlan_encap.vxlan_encap.vxlan.ipv4.da);
+    g_hwoff_vxlan_encap.bond_id = port_id;
+
+    g_hwoff_vtep_set = true;
+    return 0;
+};
+
+void hwoff_vtep_set(portid_t port_id)
+{
+    if (g_hwoff_vtep_set == true) {
+        return;
+    }
+
+    struct rte_flow_tunnel tunnel = {.type = RTE_FLOW_ITEM_TYPE_VXLAN};
+    struct rte_flow_error error = {0};
+    int ret = hwoff_parse_vetp_tunnel_info(&g_hwoff_vxlan_encap.vxlan_encap, port_id);
+    if (ret != 0) {
+        printf("hwoff offload, parse vtep info failed\n");
+        return;
+    }
+
+    // dst_addrtp_dstuplinkvxlanIPvtepip
+    tunnel.ipv4.dst_addr = g_hwoff_vxlan_encap.vxlan_encap.vxlan.ipv4.sa;
+    tunnel.tp_dst = htons(g_hwoff_vxlan_encap.vxlan_encap.vxlan.udp.dp);
+
+    ret = rte_flow_tunnel_decap_set(port_id, &tunnel, NULL, 0, &error);
+    if (ret != 0) {
+        printf("hwoff offload, set vtep failed\n");
+        return;
+    }
+}
+
