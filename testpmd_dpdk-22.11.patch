+static int hwoff_vxlan_ipv4_head_encap(struct rte_mbuf *m, struct hwoff_encap_vxlan_ipv4_data *encap_data)
+{
+    struct rte_vxlan_hdr vxlan_hdr = {0};
+    vxlan_hdr.vx_vni = encap_data->vxlan.vx_vni;
+    vxlan_hdr.vx_flags = htonl(0x08000000);
+
+    uint16_t ether_length, ipv4_total_length, ipv4_hdr_cksum, udp_length;
+    ether_length = (uint16_t)m->pkt_len;
+    ipv4_total_length = ether_length +
+		(sizeof(struct rte_vxlan_hdr) +
+		sizeof(struct rte_udp_hdr) +
+		sizeof(struct rte_ipv4_hdr));
+    udp_length = ether_length +
+		(sizeof(struct rte_vxlan_hdr) +
+		sizeof(struct rte_udp_hdr));
+    ipv4_hdr_cksum = hwoff_vxlan_ipv4_checksum_update(encap_data->ipv4.hdr_checksum, htons(ipv4_total_length));
+
+    struct rte_vxlan_hdr *vxlan = rte_pktmbuf_prepend(m, sizeof(struct rte_vxlan_hdr));
+    vxlan->vx_flags = vxlan_hdr.vx_flags;
+    vxlan->vx_vni = vxlan_hdr.vx_vni;
+
+    struct rte_udp_hdr *udp_hdr = rte_pktmbuf_prepend(m, sizeof(struct rte_udp_hdr));
+    if (udp_hdr == NULL) {
+        return -1;
+    }
+
+    encap_data->udp.dgram_len  = htons(udp_length);
+    rte_memcpy(udp_hdr, &encap_data->udp, sizeof(struct rte_udp_hdr));
+    struct rte_ipv4_hdr *ipv4  = rte_pktmbuf_prepend(m, sizeof(struct rte_ipv4_hdr));
+    if (ipv4 == NULL) {
+        return -1;
+    }
+
+    encap_data->ipv4.total_length = htons(ipv4_total_length);
+    encap_data->ipv4.hdr_checksum = ipv4_hdr_cksum;
+    rte_memcpy(ipv4, &encap_data->ipv4, sizeof(struct rte_ipv4_hdr));
+
+    struct rte_ether_hdr *eth = rte_pktmbuf_prepend(m, sizeof(struct rte_ether_hdr));
+    if (eth == NULL) {
+        return  -1;
+    }
+    rte_memcpy(eth, &encap_data->ether, sizeof(struct rte_ether_hdr));
+}
